{
  "name": "esquery",
  "version": "1.6.0",
  "author": "Joel Feenstra <jrfeenst+esquery@gmail.com>",
  "contributors": [],
  "description": "A query library for ECMAScript AST using a CSS selector like query language.",
  "main": "dist/esquery.js",
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.map",
    "parser.js",
    "license.txt",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build:parser": "peggy  -o \"parser.js\" --format es \"grammar.pegjs\" --dts",
    "build:browser": "tsc",
    "build": "npm run build:parser && npm run build:browser",
    "mocha": "mocha --require chai/register-assert tests",
    "test": "nyc npm run mocha && npm run lint",
    "test:ci": "npm run mocha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/estools/esquery.git"
  },
  "bugs": "https://github.com/estools/esquery/issues",
  "homepage": "https://github.com/estools/esquery/",
  "keywords": [
    "ast",
    "ecmascript",
    "javascript",
    "query"
  ],
  "devDependencies": {
    "@types/esprima": "^4.0.6",
    "@types/estraverse": "^5.1.7",
    "@types/estree": "^1.0.6",
    "chai": "^5.2.0",
    "esprima": "latest",
    "mocha": "^11",
    "peggy": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "estraverse": "latest"
  }
}
