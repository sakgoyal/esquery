{
  "name": "esquery",
  "version": "1.6.0",
  "author": "Joel Feenstra <jrfeenst+esquery@gmail.com>",
  "contributors": ["Saksham Goyal <sakgoy2001@gmail.com>"],
  "description": "A query library for ECMAScript AST using a CSS selector like query language.",
  "main": "dist/esquery.js",
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.map",
    "parser.js",
    "license.txt",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test:ci",
    "build:parser": "peggy --dts --format es -o parser.js grammar.pegjs",
    "build": "npm run build:parser && tsc",
    "test": "mocha tests",
    "test:ci": "npm run mocha && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/estools/esquery.git"
  },
  "bugs": "https://github.com/estools/esquery/issues",
  "homepage": "https://github.com/estools/esquery/",
  "keywords": [
    "ast",
    "ecmascript",
    "javascript",
    "query"
  ],
  "devDependencies": {
    "@types/chai": "latest",
    "@types/esprima": "latest",
    "@types/estraverse": "latest",
    "@types/estree": "latest",
    "@types/mocha": "latest",
    "@types/node": "latest",
    "chai": "^5.2.0",
    "esprima": "latest",
    "mocha": "^11",
    "peggy": "^4.2.0",
    "typescript": "latest"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "estraverse": "latest"
  }
}
